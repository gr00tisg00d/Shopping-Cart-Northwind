@model IEnumerable<CartItem>

@{
    var activeDiscounts = ViewBag.ActiveDiscounts as Dictionary<int, Discount>;
    var grandTotal = Model.Any() ? Model.Sum(item => {
        decimal dp = 0;
        if (activeDiscounts != null && activeDiscounts.ContainsKey(item.ProductId))
            dp = activeDiscounts[item.ProductId].DiscountPercent;
        return item.Product.UnitPrice * (1 - dp) * item.Quantity;
    }) : 0;
}

<div class="mx-auto mt-3" style="max-width:860px">
<h2>Shopping Cart</h2>
@if (!Model.Any())
{
    <div class="alert alert-info">
        Your cart is empty.
    </div>
}
else
{
    <table class="table table-hover">
        <thead>
            <tr>
                <th>Product</th>
                <th class="text-end">Price</th>
                <th class="text-end">Discount</th>
                <th class="text-end">Quantity</th>
                <th class="text-end">Subtotal</th>
                <th class="text-end">Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                Discount discount = null;
                decimal discountPercent = 0;

                if (activeDiscounts != null && activeDiscounts.ContainsKey(item.ProductId))
                {
                    discount = activeDiscounts[item.ProductId];
                    discountPercent = discount.DiscountPercent;
                }

                var discountedPrice = item.Product.UnitPrice * (1 - discountPercent);
                var subtotal = discountedPrice * item.Quantity;

                <tr>
                    <td>@item.Product.ProductName</td>

                    <td class="text-end">
                        @item.Product.UnitPrice.ToString("C")
                    </td>

                    <td class="text-end">
                        @if (discount != null)
                        {
                            <span class="badge bg-success">
                                @(discount.DiscountPercent.ToString("P0")) off
                            </span>
                        }
                        else
                        {
                            <span>No discount</span>
                        }
                    </td>

                    <td class="text-end">
                        <input
                            type="number"
                            class="form-control quantity-input text-end ms-auto"
                            style="width:70px"
                            value="@item.Quantity"
                            min="1"
                            data-cart-item-id="@item.CartItemId" />
                    </td>

                    <td class="text-end">
                        @subtotal.ToString("C")
                    </td>

                    <td class="text-end">
                        <button
                            class="btn btn-sm btn-danger remove-item"
                            data-cart-item-id="@item.CartItemId">
                            <i class="bi bi-trash"></i>
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="d-flex justify-content-end align-items-center gap-3 mt-3">
        <span class="fs-5 fw-bold">Total: @grandTotal.ToString("C")</span>
        <a class="btn btn-success" asp-controller="Cart" asp-action="Checkout">
            <i class="bi bi-credit-card"></i> Proceed to Checkout
        </a>
    </div>
}
</div>

@section Scripts {
    <script>
        document.querySelectorAll(".quantity-input").forEach(input => {
            input.addEventListener("change", async function () {
                const cartItemId = this.dataset.cartItemId;
                const quantity = this.value;

                await fetch("/Cart/UpdateQuantity", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/x-www-form-urlencoded"
                    },
                    body: `cartItemId=${cartItemId}&quantity=${quantity}`
                });

                location.reload();
            });
        });

        document.querySelectorAll(".remove-item").forEach(button => {
            button.addEventListener("click", async function () {
                const cartItemId = this.dataset.cartItemId;

                await fetch("/Cart/RemoveItem", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/x-www-form-urlencoded"
                    },
                    body: `cartItemId=${cartItemId}`
                });

                location.reload();
            });
        });
    </script>
}